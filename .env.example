# Copy to .env.local for local work. In Vercel, add the same names under Project → Settings → Environment Variables.

# Browser-safe values (Supabase dashboard → Project Settings → API).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only. Never prefix these with VITE_ and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
CRON_SECRET=any-long-random-string
UNSUBSCRIBE_SECRET=another-long-random-string

# Mail servers. Leave unset for GoDaddy Titan; for Google Workspace use smtp.gmail.com / imap.gmail.com.
SMTP_HOST=smtp.gmail.com
IMAP_HOST=imap.gmail.com
# App password shared by every inbox, or one per inbox: alex@yourdomain.com → INBOX_PASSWORD_ALEX_YOURDOMAIN_COM
INBOX_PASSWORD=

# Optional. "Add inbox" with Google sign-in (see README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Base URL for unsubscribe links; defaults to the Vercel production URL.
PUBLIC_URL=
# Optional. Password for the Gmail seed accounts used by the inbox placement test.
SEED_PASSWORD=

# Optional. Sorts replies with Claude (keyword rules without it).
ANTHROPIC_API_KEY=
# Optional. Copies warm-up stats from Smartlead onto the sender account pages.
SMARTLEAD_API_KEY=
